{
  "private": true,
  "name": "user-latency",
  "version": "2.1.0",
  "type": "module",
  "description": "Exibe a latência média dos usuários na lista de jogadores do Foundry VTT.",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "parcel build --no-source-maps --no-content-hash",
    "postbuild": "node scripts/postbuild.mjs && node scripts/validate-package.mjs",
    "check": "tsc --noEmit",
    "test": "npm run check && node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "author": "mawburn <mawburn7@gmail.com>",
  "contributors": [
    "SoftMissT"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@parcel/optimizer-cssnano": "^2.16.4",
    "bestzip": "^3.0.1",
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  },
  "@parcel/transformer-css": {
    "cssModules": {
      "global": true,
      "pattern": "[hash]-[local]"
    }
  },
  "browserslist": "last 2 Chrome versions",
  "targets": {
    "default": {
      "context": "browser",
      "optimize": true,
      "outputFormat": "esmodule"
    }
  },
  "source": "src/index.ts"
}
